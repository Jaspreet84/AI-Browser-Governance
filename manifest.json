{
  "manifest_version": 3,
  "name": "AI Browser Governance",
  "short_name": "AI Governance",
  "version": "0.1.0",
  "description": "Visibility, policy enforcement and an audit trail for AI agents acting inside your browser.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Browser Governance",
    "default_popup": "src/ui/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/ui/options/options.html",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "notifications",
    "webRequest",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "management",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/overlay.js",
        "src/content/sensor.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/probe.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "storage": {
    "managed_schema": "managed-schema.json"
  }
}
